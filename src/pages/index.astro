---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import Btn from '../components/Btn.astro';
import SectionHead from '../components/SectionHead.astro';

const email = 'journeysbyjaz@gmail.com';
const plan = 'https://journeysbyjaz.com/join-the-travel-list';

const stats = [
  { n: 35, p: '$', s: '', l: 'Planning fee, separate from your travel costs', c: 'dark' },
  { n: 3, p: '', s: ' days', l: 'Until your options arrive', c: '' },
  { t: '2–3', l: 'Custom options built around your budget', c: '' },
  { n: 1, p: '', s: '', l: 'Real person, before, during and after your trip', c: 'or' },
];
const kinds = [
  ['Theme-park vacations', 'Walt Disney World, Disneyland or Universal Orlando? I compare resorts, tickets and dining to fit your budget, so you get the magic without overspending or overplanning.', './img/theme-park.webp', 'A lively cruise ship pool deck with a lifeguard and families swimming'],
  ['Cruises, including from Galveston', 'Disney Cruise Line or another cruise line, your first sailing or your fifth. I help you choose the ship, cabin and itinerary, and for Houston-area travelers, a port you can drive to.', './img/cruises.webp', 'Two large cruise ships docked side by side at a sunny port'],
  ['All-inclusive resorts', 'One price, fewer surprises. Couples, families or friends: I compare all-inclusive resorts by what’s included and the total cost, so you can relax from the moment you arrive.', './img/all-inclusive.webp', 'Resort towers beside a calm lagoon and sandy beach under blue sky'],
  ['Group trips and reunions', 'Traveling with friends, cousins, grandparents or a whole crowd? I compare options for the whole group and keep the details in one plan.', './img/group-trips.webp', 'Groups gathered around hot tubs and the pool on a cruise ship deck'],
];
const steps = [
  ['01', 'Tell me your plan', 'Share your dates, budget, who’s going (including kids’ ages) and the kind of trip you want. It takes about 2 minutes.', ''],
  ['02', 'I do the research', 'Once you sign the simple service agreement and pay the $35 planning fee, I compare resorts, tickets, sailings and prices. Your 2–3 options arrive within 3 days.', 'dark'],
  ['03', 'Choose and book', 'Pick the option you love, then complete one secure Enchanted Escapes Travel booking form. I’ll handle the booking and stay in touch before, during and after your trip.', 'or'],
];
const covers = [
  ['2–3 custom Disney, cruise or vacation options', 'built around your budget and preferences'],
  ['Your options in 3 days', ''],
  ['Honest advice', 'on resorts, tickets, cabins, hotels and packages'],
  ['Fees upfront', 'The planning fee is $35, separate from your travel costs.'],
  ['A personal contact', 'before, during and after your trip'],
  ['Booking handled for you', 'Payments go directly to the travel supplier.'],
  ['A travel insurance quote', 'so you can decide whether to protect your trip'],
];
const who = [
  ['One real person.', 'You talk to me before, during and after your trip.'],
  ['An established agency behind me.', 'Your booking goes through Enchanted Escapes Travel.'],
  ['Your card is charged by the supplier.', 'Payments go directly to Disney, the cruise line or the resort. Enchanted Escapes Travel does not charge your card.'],
  ['Fees upfront.', 'The planning fee is $35, separate from your travel costs.'],
];
const faqs = [
  ['What does a travel agent do, and is it worth it?', "A travel agent researches your options, matches them to your budget, books the trip and stays reachable if plans change. It's worth it when you're comparing resorts, tickets, cruises or cabins across many tabs. For a simple one-stop trip, booking direct may be enough. I send you 2–3 custom options so you can compare real totals."],
  ['How much does Journeys by Jaz charge, and why a fee?', 'A flat, non-refundable $35 planning fee covers your 2–3 custom options. Good planning takes real time: comparing resorts, sailings, cabins and dates to find what fits your budget. The fee is separate from your travel costs, which you pay directly to the resort, cruise line or other supplier. Please read the service agreement before you pay.'],
  ['Is it cheaper to book through a travel agent?', 'Not automatically. Resorts, parks and cruise lines set their own prices, so no agent can promise a lower rate. What I can do is find the option that fits your budget and show what’s included before you book, so there are no surprises at checkout.'],
  ['How much does a vacation cost?', 'It depends on your dates, group size, destination and how you travel. Most trips add up from tickets or activities, lodging, food, transportation and extras. Cruises add gratuities, excursions and travel to the port. I build 2–3 options around your budget and show what’s included and what costs extra, so you can compare real totals.'],
  ['Can you plan Disney and Universal Orlando vacations?', 'Yes. I plan Walt Disney World, Disneyland and Universal Orlando vacations, comparing resorts, tickets and dining to fit your budget. Tell me your dates, who’s traveling and what you want to spend, and you’ll get 2–3 options that show what’s included and what costs extra.'],
  ['Can you plan an all-inclusive resort vacation?', 'Yes. I compare all-inclusive resorts for couples, families and groups, such as options in Mexico and the Caribbean, by what’s included, room types, extras and total price. You’ll see what’s covered and what costs extra before you book, so there are no surprises on arrival.'],
  ['Do you plan cruises from Galveston for Houston-area travelers?', 'Yes. Several cruise lines sail from the Port of Galveston, about an hour from Houston, so you can drive instead of fly. Disney Magic has run 4-, 5- and 7-night trips there. Dates change, so I check the current schedule, then compare sailings, cabins, parking and a pre-cruise hotel night. I work online with Houston-area travelers and clients across the U.S.'],
  ['Can you plan group trips and reunions?', 'Yes. I plan trips for friend groups, extended families and reunions on cruises, at resorts and at theme parks. I compare options for the whole group, keep the details in one plan, and tell you up front what each choice costs, so everyone knows what to expect.'],
  ['What do I get, and how do I book?', "You get 2–3 custom options within 3 days, once I have your signed service agreement, the $35 fee and your trip details. Pick your favorite, then complete the secure Enchanted Escapes Travel booking form. It doesn't charge your card. The supplier does, and it can take up to 48 hours. You can pay a deposit or deposit plus remaining payments, and request a travel insurance quote."],
  ['Is Journeys by Jaz a legitimate travel agency?', 'Journeys by Jaz is an independent travel advisor affiliated with Enchanted Escapes Travel (Enchanted Escapes, LLC) in Cypress, Texas, Florida Seller of Travel #ST40359. The agency states that Disney Destinations designated it an Authorized Disney Vacation Planner. I book through Enchanted Escapes Travel, and you pay the supplier directly.'],
];
---
<Base title="Vacation Planner & Travel Agent | Journeys by Jaz" description="Houston-area travel agent and vacation planner for Disney, Universal Orlando, all-inclusive resorts, cruises and group trips. 2–3 custom options in 3 days.">
  <header class="nav">
    <a class="logo" href="#top" aria-label="Journeys by Jaz, home"><img src="./img/logo.webp" alt="Journeys by Jaz" width="56" height="56" /></a>
    <button class="burger" aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
    <nav class="links" aria-label="Main">
      <a href="#top">Home</a>
      <div class="dd">
        <button class="dd-b" aria-expanded="false" aria-haspopup="true">Services
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <ul class="dd-m">
          <li><a href="#all-inclusive">All-inclusive Resorts</a></li>
          <li><a href="#cruises">Cruises</a></li>
          <li><a href="#group-travel">Group Travel</a></li>
          <li><a href="#theme-park">Theme-park Vacation</a></li>
        </ul>
      </div>
      <a href="#about">About Me</a>
    </nav>
    <Btn href="tel:+17138870363" class="nav-phone"><svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>+1 713 887 0363</Btn>
  </header>

  <main id="top">
    <!-- HERO -->
    <div class="hero">
      <img class="hero-img" src="./hero.webp" alt="A cruise ship docked in turquoise water under a deep blue sky" width="2000" height="1170" fetchpriority="high" />
      <div class="pill h-in"><b>$35</b> planning fee · Options in 3 days · No pressure</div>
      <div class="hero-in">
        <div>
          <div class="eyebrow h-in">Vacation planner &amp; travel agent</div>
          <h1>
            <span class="line"><span>Vacations planned</span></span>
            <span class="line"><span>around your budget.</span></span>
            <span class="line"><span>Planned for you.</span></span>
          </h1>
        </div>
        <div class="h-in">
          <p>Disney, Universal Orlando, all-inclusive resorts and cruises. Tell me your dates and your budget, and in 3 days you’ll get 2–3 custom options with everything included spelled out.</p>
          <div class="row">
            <Btn href={plan} variant="light">Plan My Trip</Btn>
            <Btn href="tel:+17138870363" variant="ghost">Call Me</Btn>
          </div>
          <div class="fee-note">$35 planning fee · Options in 3 days · No pressure</div>
        </div>
      </div>
    </div>

    <!-- STATS -->
    <section style="padding-bottom:0">
      <div class="wrap stats">
        {stats.map((s, i) => (
          <div class:list={['stat reveal', s.c]} data-delay={i * 120}>
            {s.t ? <b>{s.t}</b> : <b data-count={s.n} data-prefix={s.p} data-suffix={s.s}>{s.p}0{s.s}</b>}
            <span>{s.l}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="life">
      <div class="wrap">
        <div class="kicker reveal" style="justify-content:center"><i>01/</i><span>Stress-free getaways</span></div>
        <div class="big"><span>Plan</span><span class="life-pill"><img src="./img/plan-relax.webp" alt="A sailing ship at anchor in deep blue water" width="1024" height="575" /></span><span>Relax</span></div>
        <p class="words-p">Vacations, group trips and stress-free getaways, planned for you.</p>
      </div>
    </section>

    <section style="padding-top:0">
      <div class="wrap problem">
        <h2 class="words">Planning a vacation shouldn’t feel like a second job</h2>
        <p class="reveal">Between park tickets, resort rooms, cabins and payment dates, one trip can mean twenty open tabs. I compare the options for you, keep the total in view and handle the booking, so you can spend your time looking forward to the trip. Whether it’s a theme-park week, a cruise, an all-inclusive escape, a couples getaway or a trip with friends or family, you get a plan built around your budget.</p>
      </div>
    </section>

    <!-- VACATION TYPES (dark) -->
    <section class="dark-sec">
      <div class="wrap">
        <SectionHead n="02" kicker="Every kind of traveler" dark>
          <Fragment slot="title">Vacations I plan for every kind of traveler</Fragment>
          <p>Journeys by Jaz is a vacation planner and travel agent for Disney, Universal Orlando, all-inclusive resort, cruise and group trips.</p>
        </SectionHead>
        <div class="exp">
          {kinds.map(([t, d, img, alt], i) => (
            <div class="exp-c reveal" id={["theme-park","cruises","all-inclusive","group-travel"][i]} data-delay={(i % 2) * 120}>
              <div class="exp-img"><img src={img} alt={alt} width="1210" height="707" loading="lazy" /></div>
              <div class="exp-b">
                <h3>{t}</h3><p>{d}</p>
                <Btn href={plan} variant="ghost">Plan My Trip</Btn>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STEPS -->
    <section>
      <div class="wrap">
        <SectionHead n="03" kicker="How it works">
          <Fragment slot="title">How to plan a Disney vacation on a budget in 3 steps</Fragment>
          <p>Tell me your budget and dates. I’ll do the comparing.</p>
          <Btn href={plan}>Plan My Trip</Btn>
        </SectionHead>
        <div class="diff" style="grid-template-columns:repeat(3,1fr)">
          {steps.map(([n, t, d, c], i) => (
            <div class:list={['diff-c reveal', c]} data-delay={i * 140}>
              <span class="num">{n}</span>
              <div><h3>{t}</h3><p>{d}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEE -->
    <section style="padding-top:20px">
      <div class="wrap fee">
        <div class="fee-l">
          <div class="kicker reveal"><i>04/</i><span>Planning fee</span></div>
          <h2 class="words">What your $35 vacation planning fee covers</h2>
          <p class="reveal"><b>Why I charge a small planning fee.</b> Good planning takes real time: comparing resorts, sailings, cabin categories and dates to find what actually fits your budget. The $35 planning fee covers that research and lets me focus fully on your trip. It’s separate from your travel costs, and it’s a small price next to the hours you’d spend searching on your own.</p>
          <p class="warn reveal">The planning fee is non-refundable. It covers the time spent on research, consultation and itinerary building. The planning fee is separate from your travel costs (park tickets, resorts, cruises and so on).</p>
        </div>
        <ul class="cover">
          {covers.map(([a, b], i) => (
            <li class="reveal" data-delay={i * 90}><div><b>{a}</b>{b && <small>{b}</small>}</div></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" style="padding-top:20px">
      <div class="wrap story">
        <div class="story-img reveal">
          <Placeholder w={560} h={620} label="Photo of Jaz" />
        </div>
        <div class="story-t">
          <div class="kicker reveal"><i>05/</i><span>About me</span></div>
          <h2 class="words">Meet Jaz, your vacation planner</h2>
          <p class="reveal">I love cruises because you get to see a lot in a short amount of time without constantly packing up and moving from place to place. I also love that everything you need is right there food, entertainment, activities, and relaxation so it feels easy while still giving you a full vacation experience.</p>
          <p class="reveal" style="margin-top:-8px">I’m an independent travel advisor affiliated with Enchanted Escapes Travel (Enchanted Escapes, LLC), an Authorized Disney Vacation Planner agency in Cypress, Texas. I work online with Houston-area families and travelers across the United States.</p>
        </div>
      </div>
    </section>

    <section style="padding-top:20px">
      <div class="wrap">
        <SectionHead n="06" kicker="What that means for you">
          <Fragment slot="title">What that means for you</Fragment>
          <p>Real person, established agency, no surprises.</p>
        </SectionHead>
        <div class="grid4">
          {who.map(([t, d], i) => (
            <div class:list={['diff-c reveal', i === 1 ? 'dark' : i === 3 ? 'or' : '']} data-delay={i * 120} style="min-height:260px">
              <span class="num">0{i + 1}</span>
              <div><h3>{t}</h3><p>{d}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section style="padding-top:20px">
      <div class="wrap">
        <SectionHead n="08" kicker="Life on the water">
          <Fragment slot="title">A Glimpse Into Your Next Getaway.</Fragment>
          <p>Cruise decks, resort pools, park days and time with the people you love. These are the moments I plan every trip around.</p>
        </SectionHead>
        <div class="gal">
          <div class="g-big reveal"><img src="./img/gallery-swimming.webp" alt="Two people swimming in clear turquoise water with mountains behind" width="1050" height="1400" loading="lazy" /></div>
          <div class="reveal" data-delay="100"><img src="./img/gallery-cruise-ship.webp" alt="A Carnival cruise ship sailing past a cruise deck railing" width="1400" height="1050" loading="lazy" /></div>
          <div class="reveal" data-delay="200"><img src="./img/gallery-open-sea.webp" alt="Deep blue open sea seen from a cruise ship deck" width="1400" height="1050" loading="lazy" /></div>
          <div class="reveal" data-delay="300"><img src="./img/gallery-mountains.webp" alt="Green mountains and coastal homes across blue water" width="1400" height="1050" loading="lazy" /></div>
          <div class="reveal" data-delay="400"><img class="top" src="./img/gallery-port.webp" alt="A Royal Caribbean ship docked at the port" width="1400" height="1050" loading="lazy" /></div>
          <div class="g-big reveal" data-delay="500"><img src="./img/gallery-coast.webp" alt="Turquoise waves breaking on a rocky shore with a cruise ship on the horizon" width="1050" height="1400" loading="lazy" /></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <div class="wrap">
        <SectionHead n="07" kicker="FAQs">
          <Fragment slot="title">Frequently asked questions</Fragment>
          <p>Straight answers about fees, booking and what to expect.</p>
        </SectionHead>
        <div class="faq">
          {faqs.map(([q, a], i) => (
            <details class="reveal" data-delay={Math.min(i, 4) * 60}><summary>{q}</summary><p>{a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <h2 class="words">Tell me your budget. Get your options in 3 days.</h2>
      <div class="reveal"><Btn href={plan} variant="accent">Plan My Trip</Btn></div>
    </section>
  </main>

  <footer id="contact">
    <div class="wrap">
      <div class="fgrid">
        <div class="reveal">
          <p>Disney travel agent serving Houston, Texas and families across the U.S.</p>
          <Btn href={plan} variant="accent">Plan My Trip</Btn>
        </div>
        <div class="reveal" data-delay="100"><h4>Email</h4><ul><li><a href={`mailto:${email}`}>{email}</a></li></ul></div>
        <div class="reveal" data-delay="200"><h4>Phone</h4><ul><li><a href="tel:+17138870363">(713) 887-0363</a></li></ul></div>
        <div class="reveal" data-delay="300"><h4>Agency</h4><ul><li>Enchanted Escapes Travel</li><li>Cypress, TX</li><li>Florida Seller of Travel #ST40359</li></ul></div>
      </div>
      <div class="wordmark reveal"><span>Journeys by Jaz</span></div>
      <div class="legal" style="flex-direction:column;gap:10px">
        <p class="legal-p">Journeys by Jaz is an independent travel advisor affiliated with Enchanted Escapes Travel (Enchanted Escapes, LLC), Cypress, TX. Florida Seller of Travel #ST40359.</p>
        <p class="legal-p">Prices and availability are subject to change without notice. As to Disney artwork and logos: © Disney. Disney Cruise Line ships’ registry: The Bahamas. Journeys by Jaz is not owned or operated by The Walt Disney Company.</p>
      </div>
    </div>
  </footer>
</Base>
